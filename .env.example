# Базовый URL бэкенда
VITE_API_URL=/api
# Только черновики авторизации/команд коллеги; проекты всегда используют HTTP.
VITE_USE_MOCK_API=false
# Dev-прокси Vite на браузерный шлюз (не на внутренний сервис логики).
NISHTYAK_WEB_DEV_URL=http://127.0.0.1:8020
# Только внутренний HTTP-сервис: автоматическое описание проекта через DeepSeek.
# Требует DEEPSEEK_API_KEY и DEEPSEEK_MODEL в приватном серверном env-файле.
NISHTYAK_AUTOMATIC_REVIEW=0
