# Generate the private root .env with: python3 deploy/configure.py --origin https://example.org
# Do not copy placeholder credentials into a running deployment.
NISHTYAK_WEB_ORIGINS=https://example.org
NISHTYAK_DOMAIN=
NISHTYAK_SERVICE_TOKEN=
NISHTYAK_DOCKER_SOCKET=/var/run/docker.sock
NISHTYAK_DOCKER_GID=
NISHTYAK_AUTOMATIC_REVIEW=0
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
NISHTYAK_ACCOUNT_SESSION_SECONDS=604800
NISHTYAK_MAX_OWNER_STORAGE_BYTES=268435456
